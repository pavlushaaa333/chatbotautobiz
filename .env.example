PRODUCT_DATA_SOURCE=postgres

DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SSLMODE=prefer
DB_CONNECT_TIMEOUT_SECONDS=5

# Required when PRODUCT_DATA_SOURCE=postgres.
# Each SQL template must be parameterized and return these canonical columns:
# product_id, product_name, sku, variant, color, size, price, available_qty, product_status
# Optional compatibility columns: category_code, category_name, product_type, brand, tags, short_description
PRODUCT_SEARCH_SQL=
PRODUCT_BY_SKU_SQL=
PRODUCT_BY_ID_SQL=
PRODUCT_INVENTORY_SQL=
PRODUCT_VARIANTS_SQL=

# Optional JSON object mapping canonical field names to actual SQL result columns.
# Example only: {"product_name":"your_alias_from_sql"}
PRODUCT_COLUMN_MAP=

N8N_ORDER_WEBHOOK_URL=
N8N_ORDER_WEBHOOK_TIMEOUT_SECONDS=10
TELEGRAM_BOT_TOKEN=
