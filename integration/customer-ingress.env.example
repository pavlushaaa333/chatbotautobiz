# Candidate Gate 1 only. Do not enable until Core route/installation are provisioned.
AUTOBIZ_CUSTOMER_INGRESS_ENABLED=false
AUTOBIZ_CUSTOMER_ACCOUNT_REFERENCE=
N8N_ORDER_WEBHOOK_URL=https://<approved-n8n-domain>/webhook/v1/customer/order-intents
# Supply via your secret manager: installation-specific secret, >=32 UTF-8 bytes.
N8N_ORDER_WEBHOOK_SECRET=
# Choose above total bridge + Core request latency when enabling.
N8N_ORDER_WEBHOOK_TIMEOUT_SECONDS=20
