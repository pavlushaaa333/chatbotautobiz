# Copy to a private per-shop env file. No real secret belongs in this template.
# Enable only after the integrator provisions Core and publishes approved workflows.
AUTOBIZ_CUSTOMER_INGRESS_ENABLED=false
AUTOBIZ_CUSTOMER_ACCOUNT_REFERENCE=
N8N_ORDER_WEBHOOK_URL=https://<approved-n8n-domain>/webhook/v1/customer/order-intents
N8N_ORDER_WEBHOOK_SECRET=
N8N_ORDER_WEBHOOK_TIMEOUT_SECONDS=15
TELEGRAM_BOT_TOKEN=
AUTOBIZ_ACTIVE_SHOP_ID=
AUTOBIZ_CATALOG_SOURCE=database
AUTOBIZ_INCLUDE_SIMULATED_DATA=false
# Database/catalog settings depend on the current installation; preserve its existing
# private config. Use read-only catalog credentials restricted to this shop.
AUTOBIZ_DATA_DIR=
DB_HOST=
DB_PORT=6543
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SSLMODE=prefer
# Both api and telegram processes must use the SAME absolute path on persistent storage.
AUTOBIZ_CUSTOMER_RECEIPT_DB=
AUTOBIZ_LEGACY_ORDER_STATUS_ENABLED=false
