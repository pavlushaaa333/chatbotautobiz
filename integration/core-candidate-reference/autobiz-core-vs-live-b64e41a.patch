+++ b/backend/src/autobiz/customer_order_ingress.py
@@ -0,0 +1,330 @@
+"""Signed customer intake: installation binding, then Phase 9 draft creation only."""
+
+from __future__ import annotations
+
+import hashlib
+import hmac
+import json
+from collections.abc import Mapping
+from dataclasses import replace
+from datetime import timedelta
+from typing import Any
+from uuid import uuid4
+
+from autobiz.customer_surface import CustomerSurfaceRequest, CustomerSurfaceService
+from autobiz.external_connector import (
+    ConflictingReplay,
+    ConnectorCapability,
+    ConnectorInstallationRepository,
+    ConnectorService,
+    ConnectorType,
+    ExternalEvent,
+    ExternalEventRepository,
+    ExternalEventStatus,
+    ExternalEventType,
+    InstallationStatus,
+    LocalCredentialResolver,
+)
+from autobiz.integration_bridge_security import MAX_BRIDGE_BODY_BYTES
+from autobiz.integration_ingress import IntegrationIngress, IntegrationIngressError
+from autobiz.order_automation import (
+    ConflictingOrderReplay,
+    OrderAutomationError,
+    OrderAutomationService,
+    OrderConversionService,
+    OrderInputError,
+    build_order_runtime,
+)
+from autobiz.policy_confirmation import PolicyConfirmationService
+from autobiz.tenant import (
+    PostgresTenantAuthorization,
+    TenantContextError,
+    TenantContextResolver,
+    TenantGuard,
+    TenantIdentity,
+)
+
+CUSTOMER_ORDER_PATH = "/v1/integration/customer-order-intents"
+CUSTOMER_CONTRACT = "autobiz.customer-order-intent.v1"
+
+
+def customer_request(value: Any) -> CustomerSurfaceRequest:
+    if not isinstance(value, dict) or value.get("contract") != CUSTOMER_CONTRACT:
+        raise ValueError("unsupported customer contract")
+    allowed = {
+        "contract",
+        "surface",
+        "external_account_reference",
+        "provider_event_id",
+        "external_order_reference",
+        "customer_conversation_id",
+        "items",
+        "customer",
+        "note",
+    }
+    if set(value) - allowed or value.get("surface") != "telegram":
+        raise ValueError("unsupported customer fields or surface")
+    request = CustomerSurfaceRequest(
+        surface=value["surface"],
+        external_account_reference=value["external_account_reference"],
+        provider_event_id=value["provider_event_id"],
+        external_order_reference=value["external_order_reference"],
+        customer_conversation_id=value["customer_conversation_id"],
+        payload=value,
+        connector_type=ConnectorType.CUSTOMER_BOT,
+    )
+    # Strict limits, including fulfillment requirements, apply before any persisted event.
+    if not request.payload["items"]:
+        raise ValueError("order items required")
+    for item in value["items"]:
+        if set(item) - {"sku", "variant", "quantity"}:
+            raise ValueError("customer item cannot supply price or stock")
+    for field in ("name", "phone", "address"):
+        if not request.payload["customer"].get(field):
+            raise ValueError("fulfillment fields required")
+    if set(value["customer"]) - {"name", "phone", "address", "reference"}:
+        raise ValueError("unsupported customer fields")
+    bounded_texts = [
+        getattr(request, field)
+        for field in (
+            "surface",
+            "external_account_reference",
+            "provider_event_id",
+            "external_order_reference",
+            "customer_conversation_id",
+        )
+    ]
+    bounded_texts.extend(request.payload["customer"].values())
+    for item in request.payload["items"]:
+        bounded_texts.extend((item["sku"], item["variant"]))
+    if "note" in value:
+        if not isinstance(value["note"], str):
+            raise ValueError("note must be bounded text")
+        bounded_texts.append(request.payload["note"])
+    for field in bounded_texts:
+        if not field.strip() or any(ord(char) < 32 or ord(char) == 127 for char in field):
+            raise ValueError("empty text or control characters prohibited")
+    return request
+
+
+class CustomerOrderIngress(IntegrationIngress):
+    """Shares RFC9421 and durable nonce fences; does not change generic /events."""
+
+    def __init__(
+        self,
+        *args: Any,
+        confirmation_ttl_seconds: int,
+        customer_credentials_factory: Any = None,
+        **kwargs: Any,
+    ) -> None:
+        super().__init__(*args, **kwargs)
+        if type(confirmation_ttl_seconds) is not int or not 60 <= confirmation_ttl_seconds <= 86400:
+            raise ValueError("explicit confirmation TTL must be 60..86400 seconds")
+        self._confirmation_ttl_seconds = confirmation_ttl_seconds
+        self._customer_credentials_factory = customer_credentials_factory
+
+    def _verify_customer_proof(
+        self, connection: Any, installation: Any, value: dict[str, Any], proof: Any, now: Any
+    ) -> None:
+        if not isinstance(proof, dict) or set(proof) != {"created", "signature"}:
+            raise IntegrationIngressError(
+                401, "CUSTOMER_AUTHENTICATION_FAILED", "customer authentication failed"
+            )
+        created = proof.get("created")
+        signature = proof.get("signature")
+        if (
+            type(created) is not int
+            or abs(int(now.timestamp()) - created) > 120
+            or not isinstance(signature, str)
+            or len(signature) != 64
+        ):
+            raise IntegrationIngressError(
+                401, "CUSTOMER_AUTHENTICATION_FAILED", "customer authentication failed"
+            )
+        if self._customer_credentials_factory is None:
+            from autobiz.credential_rotation import DopplerCredentialResolver
+
+            credentials = DopplerCredentialResolver.from_environment(connection)
+        else:
+            credentials = self._customer_credentials_factory(connection)
+        secret = credentials.resolve(installation)
+        if not isinstance(secret, bytes) or len(secret) < 32:
+            raise IntegrationIngressError(
+                401, "CUSTOMER_AUTHENTICATION_FAILED", "customer authentication failed"
+            )
+        raw = json.dumps(
+            value, sort_keys=True, separators=(",", ":"), ensure_ascii=False, allow_nan=False
+        ).encode("utf-8")
+        base = b"autobiz.customer-order-intent.v1\n" + str(created).encode() + b"\n" + raw
+        expected = hmac.new(secret, base, hashlib.sha256).hexdigest()
+        if not hmac.compare_digest(expected, signature):
+            raise IntegrationIngressError(
+                401, "CUSTOMER_AUTHENTICATION_FAILED", "customer authentication failed"
+            )
+
+    def accept_raw_request(
+        self, *, body: bytes, method: str, path: str, headers: Mapping[str, str]
+    ) -> dict[str, str]:
+        if type(body) is not bytes or len(body) > MAX_BRIDGE_BODY_BYTES:
+            raise IntegrationIngressError(413, "INTEGRATION_MESSAGE_TOO_LARGE", "request too large")
+        if method != "POST" or path != CUSTOMER_ORDER_PATH:
+            raise IntegrationIngressError(
+                403, "INTEGRATION_INGRESS_DENIED", "customer ingress denied"
+            )
+        if self._header(headers, "content-type") != "application/json":
+            raise IntegrationIngressError(
+                415, "UNSUPPORTED_MEDIA_TYPE", "application/json required"
+            )
+        verified = self._verify_bridge(body, method, path, headers)
+        try:
+            envelope = json.loads(verified.body.decode("utf-8"))
+            if not isinstance(envelope, dict) or set(envelope) != {"intent", "customer_auth"}:
+                raise ValueError("customer envelope required")
+            raw_intent = envelope["intent"]
+            request = customer_request(raw_intent)
+        except (ValueError, TypeError, KeyError, UnicodeError) as error:
+            raise IntegrationIngressError(
+                422, "INVALID_CUSTOMER_ORDER_INTENT", "bounded customer fields are invalid"
+            ) from error
+        now = self._now()
+        connection = self._connection_factory()
+        try:
+            with connection.transaction():
+                installation = ConnectorInstallationRepository(connection).resolve_external_account(
+                    ConnectorType.CUSTOMER_BOT, request.external_account_reference
+                )
+                if (
+                    installation is None
+                    or installation.status is not InstallationStatus.ACTIVE
+                    or ConnectorCapability.WEBHOOK not in installation.capabilities
+                    or installation.configuration.get("customer_surface") != request.surface
+                    or installation.configuration.get("customer_ingress_principal")
+                    != verified.identity.principal
+                ):
+                    raise IntegrationIngressError(
+                        403, "INTEGRATION_INGRESS_DENIED", "customer installation is not authorized"
+                    )
+                self._verify_customer_proof(
+                    connection, installation, raw_intent, envelope["customer_auth"], now
+                )
+                resolver = TenantContextResolver(
+                    TenantGuard(PostgresTenantAuthorization(connection))
+                )
+                connectors = ConnectorService(
+                    connection,
+                    credentials=LocalCredentialResolver({}),
+                    tenant_resolver=resolver,
+                    clock=lambda: now,
+                )
+                confirmation = PolicyConfirmationService(connection, clock=lambda: now)
+                conversion = OrderConversionService(
+                    connection, confirmation=confirmation, clock=lambda: now
+                )
+                orders = OrderAutomationService(
+                    connection,
+                    connectors=connectors,
+                    runtime=build_order_runtime(
+                        connection,
+                        confirmation=confirmation,
+                        conversion=conversion,
+                        clock=lambda: now,
+                    ),
+                    clock=lambda: now,
+                )
+                service = CustomerSurfaceService(connectors, orders, resolver)
+                payload = request.payload
+                digest = hashlib.sha256(
+                    json.dumps(
+                        payload,
+                        ensure_ascii=False,
+                        sort_keys=True,
+                        separators=(",", ":"),
+                        allow_nan=False,
+                    ).encode("utf-8")
+                ).hexdigest()
+                event = ExternalEvent(
+                    event_id=uuid4(),
+                    shop_id=installation.shop_id,
+                    installation_id=installation.installation_id,
+                    connector_type=ConnectorType.CUSTOMER_BOT,
+                    provider_event_id=request.provider_event_id,
+                    event_type=ExternalEventType.ORDER_CREATED,
+                    external_object_type="order",
+                    external_object_id=request.external_order_reference,
+                    occurred_at=now,
+                    payload_digest=digest,
+                    payload=payload,
+                    correlation_id=f"customer:{request.provider_event_id}"[:255],
+                    status=ExternalEventStatus.ACCEPTED,
+                    created_at=now,
+                )
+                context = resolver.resolve(
+                    TenantIdentity(
+                        installation.actor_user_id,
+                        f"customer:{request.surface}:{request.customer_conversation_id}",
+                    ),
+                    installation.shop_id,
+                    event.correlation_id,
+                )
+                # Serialize aliases of one logical transport request without a new state table.
+                lock = hashlib.sha256(
+                    f"customer-intent:{installation.installation_id}:{request.external_order_reference}".encode()
+                ).digest()
+                connection.execute(
+                    "SELECT pg_advisory_xact_lock(%s, %s)",
+                    (
+                        int.from_bytes(lock[:4], "big", signed=True),
+                        int.from_bytes(lock[4:8], "big", signed=True),
+                    ),
+                )
+                origin = connection.execute(
+                    "SELECT event_id, payload_digest FROM core_connector_events "
+                    "WHERE shop_id=%s AND installation_id=%s AND external_object_type='order' "
+                    "AND external_object_id=%s ORDER BY created_at, event_id LIMIT 1",
+                    (
+                        context.shop_id,
+                        installation.installation_id,
+                        request.external_order_reference,
+                    ),
+                ).fetchone()
+                if origin is not None and origin[1] != digest:
+                    raise ConflictingReplay("logical customer request conflicts")
+                events = ExternalEventRepository(connection)
+                accepted = events.accept(event)
+                canonical = accepted.event if origin is None else events.get(context, origin[0])
+                if canonical is None:
+                    raise RuntimeError("canonical customer event is unavailable")
+                started = service.start_verified_order(
+                    replace(
+                        request,
+                        occurred_at=canonical.occurred_at,
+                        provider_event_id=canonical.provider_event_id,
+                    ),
+                    canonical,
+                    confirmation_expires_at=canonical.occurred_at + timedelta(
+                        seconds=self._confirmation_ttl_seconds
+                    ),
+                    now=now,
+                )
+                return {
+                    "status": "DRAFT_CREATED",
+                    "draft_status": started.draft.status,
+                    "draft_order_id": str(started.draft.draft_order_id),
+                    "external_order_reference": request.external_order_reference,
+                    "run_id": str(started.run_id),
+                    "event_id": str(started.event_id),
+                }
+        except (ConflictingReplay, ConflictingOrderReplay) as error:
+            raise IntegrationIngressError(
+                409, "INTEGRATION_EVENT_CONFLICT", "customer request conflicts with stored draft"
+            ) from error
+        except TenantContextError as error:
+            raise IntegrationIngressError(
+                403, "INTEGRATION_INGRESS_DENIED", "customer installation is not authorized"
+            ) from error
+        except (OrderInputError, OrderAutomationError, ValueError) as error:
+            raise IntegrationIngressError(
+                422, "INVALID_CUSTOMER_ORDER_INTENT", "customer order cannot be drafted"
+            ) from error
+        finally:
+            connection.close()
