+++ b/backend/src/autobiz/customer_order_runtime.py
@@ -0,0 +1,165 @@
+"""Durable customer order approval wiring; no provider calls or credentials."""
+
+from __future__ import annotations
+
+from datetime import UTC, datetime
+from typing import Any, Mapping
+from uuid import UUID
+
+from autobiz.automation_runtime import CUSTOMER_ORDER_DRAFT_APPROVAL_AUTOMATION, WorkerScope
+from autobiz.external_connector import ConnectorService, LocalCredentialResolver
+from autobiz.human_escalation import HumanEscalationService
+from autobiz.order_automation import (
+    OrderAutomationService,
+    OrderConversionService,
+    build_order_runtime,
+)
+from autobiz.policy_confirmation import ActionType, PendingActionStatus, PolicyConfirmationService
+from autobiz.surface_delivery import (
+    SurfaceAdapterRegistry,
+    SurfaceDeliveryPolicy,
+    SurfaceDeliveryService,
+)
+from autobiz.tenant import (
+    PostgresTenantAuthorization,
+    TenantContextError,
+    TenantContextResolver,
+    TenantGuard,
+    TenantIdentity,
+)
+
+
+def confirmation_expiry(payload: Mapping[str, Any], now: datetime) -> datetime:
+    value = payload.get("confirmation_expires_at")
+    if not isinstance(value, str):
+        raise ValueError("durable customer confirmation expiry is required")
+    expiry = datetime.fromisoformat(value)
+    if expiry.tzinfo is None or expiry <= now:
+        raise ValueError("customer confirmation expiry is stale")
+    return expiry.astimezone(UTC)
+
+
+def _resolver(connection: Any) -> TenantContextResolver:
+    return TenantContextResolver(TenantGuard(PostgresTenantAuthorization(connection)))
+
+
+def plan_waiting_order_attention(connection: Any, now: datetime) -> bool:
+    # Recovery also runs after a restart between WAITING and outbox planning.
+    with connection.transaction():
+        rows = connection.execute(
+            """
+            SELECT r.run_id, r.shop_id, r.initiating_actor_user_id,
+                   r.conversation_chat_id, r.correlation_id, e.event_id
+            FROM core_automation_runs r
+            JOIN core_automation_events e ON e.automation_run_id = r.run_id::text
+              AND e.shop_id = r.shop_id AND e.event_code = 'AUTOMATION_WAITING_CONFIRMATION'
+            JOIN core_automation_run_steps s ON s.run_id=r.run_id
+            JOIN core_pending_actions p ON p.pending_action_id=s.pending_action_id
+            WHERE r.automation_id = %s AND r.status = 'WAITING_CONFIRMATION'
+              AND p.status='PENDING' AND p.expires_at > %s
+              AND NOT EXISTS (
+                SELECT 1 FROM core_surface_deliveries d
+                JOIN core_human_escalations h ON h.escalation_id = d.escalation_id
+                WHERE h.shop_id = r.shop_id AND h.linked_run_id = r.run_id)
+            ORDER BY r.created_at, r.run_id LIMIT 20
+            FOR UPDATE OF r SKIP LOCKED
+            """,
+            (CUSTOMER_ORDER_DRAFT_APPROVAL_AUTOMATION.automation_id, now),
+        ).fetchall()
+        for run_id, shop, actor, conversation, correlation, event_id in rows:
+            try:
+                context = _resolver(connection).resolve(
+                    TenantIdentity(actor, conversation), str(shop), correlation
+                )
+            except TenantContextError:
+                continue
+            bindings = connection.execute(
+                "SELECT binding_id FROM core_surface_bindings WHERE shop_id=%s "
+                "AND actor_user_id=%s AND surface='telegram' AND status='ACTIVE' "
+                "AND conversation_type='PRIVATE' ORDER BY binding_id LIMIT 2",
+                (shop, actor),
+            ).fetchall()
+            # Ambiguous/missing destinations stay pending; never guess a shop or actor.
+            if len(bindings) != 1:
+                continue
+            escalations = HumanEscalationService(connection, clock=lambda: now)
+            case = escalations.materialize_event(context, event_id).case
+            if case is None:
+                continue
+            service = SurfaceDeliveryService(
+                connection,
+                escalations=escalations,
+                policy=SurfaceDeliveryPolicy(),
+                adapters=SurfaceAdapterRegistry(),
+                clock=lambda: now,
+            )
+            delivery = service.plan(context, case.escalation_id, binding_id=bindings[0][0])
+            if delivery is not None:
+                return True
+    return False
+
+
+def decide_order(
+    connection: Any, owner_context: Any, pending_id: UUID, *, approve: bool, now: datetime
+) -> str:
+    if owner_context.role != "owner":
+        raise ValueError("owner authority is required")
+    with connection.transaction():
+        row = connection.execute(
+            """
+            SELECT r.run_id, r.conversation_chat_id, r.correlation_id, r.status
+            FROM core_automation_runs r JOIN core_automation_run_steps s ON s.run_id=r.run_id
+            JOIN core_pending_actions p ON p.pending_action_id=s.pending_action_id
+            WHERE r.shop_id=%s AND p.shop_id=r.shop_id AND p.pending_action_id=%s
+              AND r.initiating_actor_user_id=%s AND p.requesting_actor_user_id=%s
+              AND r.automation_id=%s
+            FOR UPDATE OF r
+            """,
+            (
+                owner_context.shop_id,
+                pending_id,
+                owner_context.actor_user_id,
+                owner_context.actor_user_id,
+                CUSTOMER_ORDER_DRAFT_APPROVAL_AUTOMATION.automation_id,
+            ),
+        ).fetchone()
+        if row is None:
+            raise ValueError("customer order decision is not bound to this owner")
+        context = _resolver(connection).resolve(
+            TenantIdentity(owner_context.actor_user_id, row[1]), owner_context.shop_id, row[2]
+        )
+        confirmation = PolicyConfirmationService(connection, clock=lambda: now)
+        pending = confirmation.get_pending_action(context, pending_id, now=now)
+        if pending.action_type is not ActionType.ORDER_CONVERSION:
+            raise ValueError("customer order conversion is required")
+        if pending.status is PendingActionStatus.CANCELLED:
+            return "REJECTED"
+        if pending.status is PendingActionStatus.EXPIRED:
+            raise ValueError("customer order decision expired")
+        if row[3] == "COMPLETED":
+            return "COMPLETED"
+        conversion = OrderConversionService(
+            connection, confirmation=confirmation, clock=lambda: now
+        )
+        runtime = build_order_runtime(
+            connection, confirmation=confirmation, conversion=conversion, clock=lambda: now
+        )
+        if approve:
+            confirmation.confirm_pending_action(context, pending_id, now=now)
+            run = runtime.resume_confirmed(
+                context, WorkerScope("customer-owner-decision"), row[0], pending_id, now=now
+            )
+            return run.status.value
+        if pending.status is PendingActionStatus.CONFIRMED:
+            return "ALREADY_CONFIRMED"
+        resolver = _resolver(connection)
+        service = OrderAutomationService(
+            connection,
+            connectors=ConnectorService(
+                connection, credentials=LocalCredentialResolver({}), tenant_resolver=resolver
+            ),
+            runtime=runtime,
+            confirmation=confirmation,
+            clock=lambda: now,
+        )
+        return service.reject_pending_action(context, pending_id, now=now).status
