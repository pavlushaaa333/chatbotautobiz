+++ b/backend/src/autobiz/customer_result_delivery.py
@@ -0,0 +1,120 @@
+"""Customer-result outbox -> authenticated n8n transport; no direct provider call."""
+
+from __future__ import annotations
+
+import hashlib
+import hmac
+import json
+from datetime import UTC, datetime, timedelta
+from uuid import UUID
+
+from autobiz.audit_outbox import CUSTOMER_RESULT_MESSAGE_TYPE, DeliveryFailure
+from autobiz.external_connector import (
+    ConnectorInstallationRepository,
+    ConnectorType,
+    InstallationStatus,
+)
+from autobiz.integration_outbound import DispatchState
+from autobiz.integration_protocol import ActionIntent, ProtocolCapability
+from autobiz.tenant import (
+    PostgresTenantAuthorization,
+    TenantContextResolver,
+    TenantGuard,
+    TenantIdentity,
+)
+
+CONTRACT = "autobiz.customer-order-result.v1"
+
+
+def sign_customer_result(result, secret: bytes, created: int):
+    if not isinstance(secret, bytes) or len(secret) < 32:
+        raise ValueError("customer result credential is unavailable")
+    raw = json.dumps(
+        result, sort_keys=True, ensure_ascii=False, separators=(",", ":"), allow_nan=False
+    ).encode()
+    material = CONTRACT.encode() + b"\n" + str(created).encode() + b"\n" + raw
+    return {
+        "result": result,
+        "customer_auth": {
+            "created": created,
+            "signature": hmac.new(secret, material, hashlib.sha256).hexdigest(),
+        },
+    }
+
+
+class CustomerResultHandler:
+    def __init__(self, connection, gateway, credentials, *, clock=None):
+        self.connection, self.gateway, self.credentials = connection, gateway, credentials
+        self.clock = clock or (lambda: datetime.now(UTC))
+
+    def deliver(self, message):
+        if message.message_type != CUSTOMER_RESULT_MESSAGE_TYPE:
+            raise DeliveryFailure("TERMINAL_INVALID_RESULT", "unsupported customer result message")
+        payload = message.payload
+        with self.connection.transaction():
+            row = self.connection.execute(
+                "SELECT d.source_installation_id,d.source_conversation_id,i.actor_user_id "
+                "FROM draft_orders d JOIN core_connector_installations i "
+                "ON i.installation_id=d.source_installation_id AND i.shop_id=d.shop_id "
+                "WHERE d.id=%s AND d.shop_id=%s",
+                (UUID(payload["draft_order_id"]), message.shop_id),
+            ).fetchone()
+            if row is None or row[1] != payload["customer_conversation_id"]:
+                raise DeliveryFailure(
+                    "TERMINAL_CUSTOMER_BINDING", "customer draft binding unavailable"
+                )
+            context = TenantContextResolver(
+                TenantGuard(PostgresTenantAuthorization(self.connection))
+            ).resolve(
+                TenantIdentity(row[2], f"customer-result:{row[1]}"),
+                message.shop_id,
+                message.correlation_id,
+            )
+            installation = ConnectorInstallationRepository(self.connection).get(context, row[0])
+            if (
+                installation is None
+                or installation.status is not InstallationStatus.ACTIVE
+                or installation.connector_type is not ConnectorType.CUSTOMER_BOT
+            ):
+                raise DeliveryFailure(
+                    "TERMINAL_CUSTOMER_INSTALLATION", "customer installation unavailable"
+                )
+            result = {
+                "contract": CONTRACT,
+                "external_account_reference": installation.external_account_reference,
+                "result_id": payload["result_id"],
+                "draft_order_id": payload["draft_order_id"],
+                "customer_conversation_id": row[1],
+                "result_kind": payload["result_kind"],
+                "order_id": payload["order_id"],
+            }
+            now = self.clock()
+            envelope = sign_customer_result(
+                result, self.credentials.resolve(installation), int(now.timestamp())
+            )
+        opaque = message.outbox_id.hex.translate(
+            str.maketrans("0123456789abcdef", "abcdefghijklmnop")
+        )
+        identity = f"customer-result:{opaque}"
+        intent = ActionIntent(
+            message_id=f"{identity}:{message.attempt_count}",
+            action_id=identity,
+            attempt_id=f"{identity}:{message.attempt_count}",
+            installation_id=str(installation.installation_id),
+            capability=ProtocolCapability.CUSTOMER_RESULT.value,
+            action_type="customer.result",
+            idempotency_key=identity,
+            correlation_id=message.correlation_id,
+            created_at=now,
